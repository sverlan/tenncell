# Generated by nnc-gen -t sva: mode=formal, style=monitor, depth=12, max_bound=1024
# Formal checks of formal_follow: rows 0..11 after reset. Engine
# depth 14 = rows + 2 (the reset step, and clocked assertions
# report one step after the row they check). prove_kind (k-induction,
# induction length 14) and prove_pdr prove all assertions for runs of
# any length; only PASS means proved. Run: sby -f <this file> [task]
[tasks]
bmc
cover
prove_kind
prove_pdr

[options]
bmc: mode bmc
cover: mode cover
prove_kind: mode prove
prove_pdr: mode prove
depth 14
multiclock off

[engines]
bmc: smtbmc
cover: smtbmc
prove_kind: smtbmc
prove_pdr: abc pdr

[script]
plugin -i slang
read_slang -D FORMAL follow.sv follow_sva.sv follow_sva_bind.sv --top formal_follow
prep -top formal_follow
async2sync

[files]
follow.sv
follow_sva.sv
follow_sva_bind.sv
