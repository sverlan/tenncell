# Template for .env: local tool paths for the opt-in tests. Copy it to .env
# (git-ignored) and fill in the tools you have; a test whose variable is unset
# or points nowhere is skipped. `pdm test` and the other pdm scripts load .env;
# for a plain `pytest`, load it first with scripts\load-env.ps1 (PowerShell)
# or scripts\load-env.cmd (cmd). Variables already set in the shell win.
# Format: KEY=value, no quotes (values may contain spaces), # comments.
# Paths below are examples (oss-cad-suite under C:\tools).

# Icarus Verilog (iverilog; vvp next to it)
NNC_IVERILOG=C:\tools\oss-cad-suite\bin\iverilog.exe
# Verilator (verilator_bin; VERILATOR_ROOT defaults to <oss-cad-suite>\share\verilator)
NNC_VERILATOR=C:\tools\oss-cad-suite\bin\verilator_bin.exe
# make and g++ for Verilator simulation builds (PATH entries, ;-separated)
NNC_CXX_PATH=C:\tools\msys64\mingw64\bin;C:\tools\msys64\usr\bin
# Yosys with the slang plugin
NNC_YOSYS=C:\tools\oss-cad-suite\bin\yosys.exe
# SymbiYosys (bmc, cover, prove)
NNC_SBY=C:\tools\oss-cad-suite\bin\sby.exe
# SymbiYosys with suprove for the live task (Linux oss-cad-suite): a command,
# split on whitespace and run in the output folder, e.g. through WSL
NNC_SBY_LIVE=wsl -e /mnt/c/tools/oss-cad-suite-linux/bin/sby
# Webots: on Windows the launcher <Webots>\msys64\mingw64\bin\webots.exe
NNC_WEBOTS=C:\Program Files\Webots\msys64\mingw64\bin\webots.exe
# MC2 model checker jar (java on PATH)
NNC_MC2_JAR=C:\tools\mc2\MC2v2.0beta2.jar
